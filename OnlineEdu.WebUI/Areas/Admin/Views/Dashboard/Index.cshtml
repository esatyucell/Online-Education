@model ResultDashboardDTO
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


@{
    int count = 0;
}


<style>
    /* Sadece bu sayfadaki kartlara özel modern tasarım kuralları */
    .modern-stat-card {
        border-radius: 20px !important; /* Yumuşak ve modern köşeler */
        box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important; /* Derinlik katan hafif gölge */
        transition: all 0.4s ease !important; /* Yağ gibi akan animasyon süresi */
        border: none !important;
        overflow: hidden;
    }

    /* Kartın üzerine fareyle gelince çalışacak efektler */
    .modern-stat-card:hover {
        transform: translateY(-8px) !important; /* Kartı 8 piksel yukarı kaldır */
        box-shadow: 0 15px 30px rgba(0,0,0,0.15) !important; /* Gölgeyi belirginleştir */
    }

    .modern-stat-card .inner {
        padding: 25px !important;
    }

    .modern-stat-card h3 {
        font-weight: 800 !important;
        font-size: 2.8rem !important;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2); /* Rakamlara 3D havası veren gölge */
    }

    .modern-stat-card p {
        font-weight: 600;
        font-size: 1.1rem;
        letter-spacing: 1px; /* Harflerin arasını hafifçe açar */
    }

    /* Arka plandaki dev ikonun tasarımı */
    .modern-stat-card .icon > i {
        font-size: 4.5rem !important;
        opacity: 0.25 !important; /* İkonu yarı saydam yapıp arka plana gömer */
        transition: all 0.4s ease;
    }

    /* Üzerine gelince ikonu döndür ve büyüt */
    .modern-stat-card:hover .icon > i {
        transform: scale(1.3) rotate(15deg); 
        opacity: 0.4 !important;
    }
</style>

<div class="row mt-4"> <div class="col-lg-3 col-6">
        <div class="small-box modern-stat-card" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color: white;">
            <div class="inner">
                <h3>@Model.CourseCount</h3>
                <p>TOPLAM KURS</p>
            </div>
            <div class="icon">
                <i class="fas fa-graduation-cap"></i>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box modern-stat-card" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); color: white;">
            <div class="inner">
                <h3>@Model.BlogCount</h3>
                <p>TOPLAM BLOG</p>
            </div>
            <div class="icon">
                <i class="fas fa-book-open"></i> 
            </div>
        </div>
    </div>

</div>