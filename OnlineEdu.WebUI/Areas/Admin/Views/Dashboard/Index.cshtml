@model OnlineEdu.UI.DTOs.DashboardDTOs.ResultDashboardDTO
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- ÖZEL DASHBOARD STİLLERİ -->
<style>
    .stat-card {
        background: #ffffff;
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        }

    .stat-icon {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
    }

    .chart-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        padding: 20px;
    }
</style>

<!-- İSTATİSTİK KARTLARI -->
<div class="row">
    <!-- Toplam Kurslar -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card h-100 py-2">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #64748B;">Toplam Kurs</div>
                        <div class="h3 mb-0 font-weight-bold text-dark">@(Model?.CourseCount ?? 0)</div>
                    </div>
                    <div class="col-auto">
                        <div class="stat-icon" style="background: #EFF6FF; color: #0A58CA;">
                            <i class="mdi mdi-keyboard"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toplam Eğitmenler -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card h-100 py-2">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #64748B;">Eğitmen Sayısı</div>
                        <div class="h3 mb-0 font-weight-bold text-dark">@(Model?.TeacherCount ?? 0)</div>
                    </div>
                    <div class="col-auto">
                        <div class="stat-icon" style="background: #ECFDF5; color: #10B981;">
                            <i class="mdi mdi-account-star"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toplam Öğrenciler -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card h-100 py-2">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #64748B;">Öğrenci Sayısı</div>
                        <div class="h3 mb-0 font-weight-bold text-dark">@(Model?.StudentCount ?? 0)</div>
                    </div>
                    <div class="col-auto">
                        <div class="stat-icon" style="background: #FFF7ED; color: #F97316;">
                            <i class="mdi mdi-school"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toplam Bloglar / Haberler -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card h-100 py-2">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #64748B;">Toplam Blog</div>
                        <div class="h3 mb-0 font-weight-bold text-dark">@(Model?.BlogCount ?? 0)</div>
                    </div>
                    <div class="col-auto">
                        <div class="stat-icon" style="background: #F3E8FF; color: #A855F7;">
                            <i class="mdi mdi-newspaper"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- GRAFİK ALANI -->
<div class="row mt-3">
    <div class="col-lg-12">
        <div class="chart-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="m-0 font-weight-bold" style="color: #0A58CA;">
                    <i class="mdi mdi-chart-line mr-2"></i>Aylara Göre Açılan Kurs Grafiği
                </h5>
                <span class="badge badge-pill badge-light text-muted p-2">Dinamik İstatistik</span>
            </div>
            <div style="position: relative; height:350px; width:100%">
                <canvas id="monthlyCourseChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- CHART.JS KÜTÜPHANESİ VE GRAFİK SCRIPT'İ -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Controller'dan gelen JSON verilerini alıyoruz
        const chartLabels = JSON.parse('@Html.Raw(ViewBag.ChartLabels ?? "[]")');
        const chartData = JSON.parse('@Html.Raw(ViewBag.ChartData ?? "[]")');

        const ctx = document.getElementById('monthlyCourseChart').getContext('2d');

        // Mavi Gradient Arka Plan Oluşturma
        const gradient = ctx.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, 'rgba(10, 88, 202, 0.35)');
        gradient.addColorStop(1, 'rgba(10, 88, 202, 0.0)');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Açılan Kurs Sayısı',
                    data: chartData,
                    borderColor: '#0A58CA',
                    borderWidth: 3,
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.4, // Yumuşatılmış kavisli çizgiler
                    pointBackgroundColor: '#0A58CA',
                    pointBorderColor: '#FFFFFF',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: '#1E293B',
                        padding: 12,
                        titleFont: { size: 14, weight: 'bold' },
                        bodyFont: { size: 13 },
                        cornerRadius: 8
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            color: '#64748B',
                            font: { size: 12 }
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: '#F1F5F9'
                        },
                        ticks: {
                            color: '#64748B',
                            font: { size: 12 },
                            stepSize: 1
                        }
                    }
                }
            }
        });
    });
</script>