@model UpdateBannerDTO

@{
    ViewData["Title"] = "Banner Güncelleme Sayfası";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<form method="post">
    <input type="hidden" asp-for="BannerId" />
    <label>Açıklama</label>
    <textarea asp-for="Title" class="form-control" rows="5"></textarea>
    <br />
    <label>Resim Url 1</label>
    <input type="text" asp-for="ImageUrl" class="form-control" />
    <br />
    <button class="btn btn-outline-primary">Kaydet</button>
</form>