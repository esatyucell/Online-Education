@model List<ResultBannerDTO>

<div class="slider-area">
    <div class="slider-active">
        @foreach (var item in Model)
        {
            <!-- 🚀 Mavi rengi ezen ve görseli tam kaplayan Background Kodu Buraya Eklendi -->
            <div class="single-slider slider-height d-flex align-items-center"
                 style="background-image: url('@item.ImageUrl'); background-size: cover; background-position: center; background-repeat: no-repeat;">

                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-xl-6 col-lg-7 col-md-8">
                            <div class="hero__caption">
                                <!-- Yazılar arka planda kaybolmasın diye hafif gölge eklendi -->
                                <span data-animation="fadeInLeft" data-delay=".2s" style="color: white; text-shadow: 1px 1px 3px rgba(0,0,0,0.7);">
                                    Popüler Çevrimiçi Kurslar
                                </span>
                                <h1 data-animation="fadeInLeft" data-delay=".4s" style="color: white; text-shadow: 2px 2px 5px rgba(0,0,0,0.8);">
                                    @item.Title
                                </h1>
                                <!-- Hero-btn -->
                                <div class="hero__btn">
                                    <a href="/Course/Index" class="btn hero-btn" data-animation="fadeInLeft" data-delay=".8s">Hemen Başla</a>
                                </div>
                            </div>
                        </div>

                        <!-- hero-man (sağdaki sorunlu küçük resim) kaldırıldı, çünkü resim artık tüm arkaplanda -->

                    </div>
                </div>
            </div>
        }
    </div>
</div>